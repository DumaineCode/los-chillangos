{
  "name": "los-chillangos",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "CDMX E-Bike & Walking Tours — Next.js 15 + Payload CMS migration in progress.",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.1.1",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "payload": "payload",
    "generate:types": "payload generate:types",
    "generate:importmap": "payload generate:importmap",
    "seed:admin": "tsx scripts/seed-admin.ts",
    "seed": "tsx scripts/seed.ts",
    "seed:seasonal": "tsx scripts/seed-seasonal.ts",
    "seed:all": "pnpm seed:admin && pnpm seed",
    "migrate:landing": "tsx scripts/migrate-landing.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:report": "playwright show-report",
    "email": "email dev --dir src/emails --port 3001"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.84.1",
    "@payloadcms/live-preview-react": "3.84.1",
    "@payloadcms/next": "3.84.1",
    "@payloadcms/richtext-lexical": "3.84.1",
    "@payloadcms/storage-s3": "3.84.1",
    "@payloadcms/ui": "3.84.1",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.0.8",
    "dotenv": "^16.4.7",
    "graphql": "^16.8.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.17.0",
    "next": "15.4.11",
    "next-intl": "^4.12.0",
    "payload": "3.84.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "resend": "^6.12.4",
    "sharp": "^0.34.0",
    "stripe": "^22.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@playwright/test": "^1.60.0",
    "@react-email/ui": "6.6.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.7",
    "eslint": "^9.0.0",
    "eslint-config-next": "15.4.11",
    "jsdom": "^29.1.1",
    "prettier": "^3.3.0",
    "react-email": "^6.6.0",
    "tsx": "^4.21.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.7"
  }
}
