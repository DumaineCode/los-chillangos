# Los Chillangos — environment variables
#
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# Server-only secrets (DATABASE_URL, PAYLOAD_SECRET, R2_*) MUST NOT be
# prefixed with NEXT_PUBLIC_ — they'd leak into client bundles.

# --- Public ---
# Canonical site URL — used for hreflang + OG tags (set per environment).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Payload + Postgres (PR 2) ---
# Postgres connection string. Neon recommended.
# Format: postgresql://USER:PASS@HOST/DB?sslmode=require
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Random 32+ char secret used by Payload to sign tokens.
# Generate with: openssl rand -base64 48
PAYLOAD_SECRET=replace-with-a-long-random-string

# --- Admin seed (PR 2) ---
# Used once by `pnpm seed:admin` to create the first admin user.
# After that the user is in Postgres and you change credentials in /admin.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=replace-me-strong-password

# --- Media storage (PR 2) ---
# `local` = filesystem under ./media (gitignored). Use for dev.
# `r2`    = Cloudflare R2 via @payloadcms/storage-s3. Use for prod.
#           When set to `r2`, ALL R2_* vars below MUST be present or
#           Payload will fail to boot with an explicit error message.
MEDIA_STORAGE=local

# --- Cloudflare R2 (required when MEDIA_STORAGE=r2) ---
# Your R2 account ID. Endpoint is derived as:
#   https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCOUNT_ID=
# Bucket name (must already exist in R2).
R2_BUCKET=
# Access key pair scoped to the bucket (R2 → Manage R2 API Tokens).
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Public read URL — either *.r2.dev or a custom domain bound to the bucket.
# This is what `next/image` and the public site will fetch from.
R2_PUBLIC_URL=

# --- Playwright E2E (PR 6) ---
# Base URL Playwright targets. Override when testing against a deployed
# preview. Default matches `pnpm dev`.
BASE_URL=http://localhost:3000

# --- Stripe (Sub-etapa C — Test Mode in dev, Live in prod) ---
# Server-only secret key. NEVER expose to the client.
STRIPE_SECRET_KEY=sk_test_replace-with-test-secret-key
# Same value as STRIPE_PUBLISHABLE_KEY, intentionally duplicated for the
# client bundle. Kept around even though Checkout redirect doesn't need it —
# the embedded Elements path (a future option) would.
STRIPE_PUBLISHABLE_KEY=pk_test_replace-with-test-publishable-key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace-with-test-publishable-key
# Webhook signing secret. Get via `stripe listen --print-secret` locally or
# from the Stripe Dashboard → Developers → Webhooks → endpoint signing secret.
STRIPE_WEBHOOK_SECRET=whsec_replace-with-webhook-signing-secret

# --- Cron secret (Vercel cron Authorization header) ---
# Used by /api/cron/sweep-bookings. Vercel sends `Authorization: Bearer <this>`.
# Generate with: openssl rand -hex 32
CRON_SECRET=replace-me-with-a-long-random-string
